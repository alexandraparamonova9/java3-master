{
  "info": {
    "name": "Лабораторная 3 — Students API и JWT",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Подготовьте ADMIN по README, задайте adminUsername/adminPassword и запускайте запросы по порядку. USER и тестовый студент создаются коллекцией. Токены сохраняются автоматически."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "adminUsername",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "userPassword",
      "value": "Lab3TestPassword123",
      "type": "string"
    },
    {
      "key": "username",
      "value": "",
      "type": "string"
    },
    {
      "key": "email",
      "value": "",
      "type": "string"
    },
    {
      "key": "isuId",
      "value": "",
      "type": "string"
    },
    {
      "key": "studentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "userAccessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userRefreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminAccessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminRefreshToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 — Регистрация USER",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{userPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now().toString();",
              "pm.collectionVariables.set(\"username\", \"lab3_user_\" + suffix);",
              "pm.collectionVariables.set(\"email\", \"lab3_\" + suffix + \"@example.com\");",
              "pm.collectionVariables.set(\"isuId\", suffix);",
              "pm.collectionVariables.unset(\"studentId\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code < 300) { const data = pm.response.json(); pm.collectionVariables.set(\"userAccessToken\", data.accessToken); pm.collectionVariables.set(\"userRefreshToken\", data.refreshToken); }"
            ]
          }
        }
      ]
    },
    {
      "name": "02 — Повторная регистрация: 409",
